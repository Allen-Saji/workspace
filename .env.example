# Defaults to loopback SQLite. Vercel refuses SQLite mode.
WORKSPACE_STORAGE=sqlite
# Fill only after a dedicated project's provisioning is approved.
# WORKSPACE_STORAGE=supabase
# WORKSPACE_ORIGIN=https://your-reviewed-origin.example
# SUPABASE_URL=https://your-reviewed-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_AFTER_APPROVAL
# Never put service-role keys or database passwords in this app.
# Disabled until the self_workspace_candidate migration is reviewed/applied.
# WORKSPACE_SELF_ONBOARDING=enabled

# Enable only after the Google provider is configured and reviewed.
# WORKSPACE_GOOGLE_AUTH=enabled

# Optional, ONLY after the exact public deployment origin is verified.
# WORKSPACE_PUBLIC_ORIGIN=https://your-verified-origin.example

# Server-only assistant configuration. Never use NEXT_PUBLIC_ for these values.
# Requires an explicitly approved runtime budget and owner activation (docs/ASSISTANT.md).
# WORKSPACE_ASSISTANT=enabled
# WORKSPACE_ASSISTANT_DAILY_USD=1
# WORKSPACE_ASSISTANT_OWNER_ID=your_verified_supabase_user_id
# OPENAI_API_KEY=your_server_key
# Shared encryption key: base64-encoded 32 random bytes. Back up before rotating.
# WORKSPACE_INTEGRATION_KEY=your_base64_key

# Separate Google Calendar OAuth web client (docs/CALENDAR.md).
# WORKSPACE_GOOGLE_CLIENT_ID=your_web_client_id
# WORKSPACE_GOOGLE_CLIENT_SECRET=your_web_client_secret
